class Solution {
    public int numberOfSteps(int num) {
        // num reduces to zero steps 
        int steps_c=0;
        while(num>0){
            if(num%2==0){
                steps_c++;
                num/=2;
            }
            else{
                num-=1;
                steps_c++;
            }
        }
        return steps_c;
    }
}
