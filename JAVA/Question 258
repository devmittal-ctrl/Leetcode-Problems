class Solution {
    public int addDigits(int num) {
        // repeaditly addition of digits of a number
        int count=calu(num);
        while(count>=10){
            count=calu(count);
        }
        return count;
    }
    static int calu(int num1){
        int answer=0;
        while(num1!=0){
            answer+=(num1%10);
            num1/=10;
        }
        return answer;
    }
}
