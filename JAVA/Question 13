class Solution {
    public int romanToInt(String s) {
        // roman to intergers: for handling the out of range 
        // s.charAt[i]-s.charAt(i+1)<0
        int answer=0,num=0,store=0;
        for(int i=s.length()-1;i>=0;i--){
            switch(s.charAt(i)){
                case 'I'-> num=1;
                case 'V'-> num=5;
                case 'X'-> num=10;
                case 'L'-> num=50;
                case 'C'-> num=100;
                case 'D'-> num=500;
                case 'M'-> num=1000;
            }
            if(num<store) answer-=num;
            else answer+=num;
            store=num;
        }
        return answer;
    }
}
