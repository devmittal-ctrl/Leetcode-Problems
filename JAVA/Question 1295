class Solution {
    public int findNumbers(int[] nums) {
        // maximun number in range 10^5;
        int count=0;
        for(int i=0;i<nums.length;i++){
            if(nums[i]>=10 && nums[i]<100) count++; // 2 digit handles
            else if(nums[i]>=1000 && nums[i]<10000) count++; // 4 digit number handles
            else if(nums[i]==100000) count++;
        }
        return count;
    }
}
