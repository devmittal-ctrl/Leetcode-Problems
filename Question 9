class Solution {
    public boolean isPalindrome(int x) {
        if(x<0) return false;
        if(x==0) return true;
        int ogn=x;
        int an=0;
        while(ogn>0){ // runs till the number
        an=an*10 + (ogn%10);
        ogn/=10;
        }
        if(an==x) return true;
        else return false;
    }
}
